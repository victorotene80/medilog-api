@baseUrl = http://localhost:8080/api/v1
@authPhone = +2347015332038
@authPassword = NewPassword123!


### Auth - Login And Store Tokens
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "phone": "{{authPhone}}",
  "password": "{{authPassword}}"
}

> {%
    let body = response.body || {};
    if (typeof body === "string") {
        body = JSON.parse(body);
    }

    const tokens = body.data && body.data.tokens ? body.data.tokens : null;
    if (!tokens || !tokens.access_token || !tokens.refresh_token) {
        throw new Error("Expected login response tokens at data.tokens.access_token and data.tokens.refresh_token");
    }

    client.global.set("accessToken", tokens.access_token);
    client.global.set("authAccessToken", tokens.access_token);
    client.global.set("refreshToken", tokens.refresh_token);
    client.global.set("authRefreshToken", tokens.refresh_token);
%}


### E2E 1 - Create AI Conversation With Medication And Visit Context
POST {{baseUrl}}/ai/conversations
Authorization: Bearer {{authAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Medication safety question",
  "related_medication_public_id": "{{medicationPublicId}}",
  "related_visit_public_id": "{{visitPublicId}}"
}

> {%
    if (response.body && response.body.data && response.body.data.public_id) {
        client.global.set("conversationPublicId", response.body.data.public_id);
    }
%}


### E2E 2 - Send AI Message About Allergy And Medication
POST {{baseUrl}}/ai/conversations/{{conversationPublicId}}/messages
Authorization: Bearer {{authAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "message": "Based on my records, is Amoxicillin safe for me if I have a Penicillin allergy?",
  "language": "English"
}


### E2E 3 - Send AI Follow-Up Message
POST {{baseUrl}}/ai/conversations/{{conversationPublicId}}/messages
Authorization: Bearer {{authAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "message": "What should I ask my doctor before taking it?",
  "language": "English"
}


### E2E 4 - Get AI Conversation With Messages
GET {{baseUrl}}/ai/conversations/{{conversationPublicId}}
Authorization: Bearer {{authAccessToken}}
Accept: application/json


### E2E 5 - List Active AI Conversations
GET {{baseUrl}}/ai/conversations?active_only=true
Authorization: Bearer {{authAccessToken}}
Accept: application/json


### Optional - Create AI Conversation Without Related Records
POST {{baseUrl}}/ai/conversations
Authorization: Bearer {{authAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "General health record question"
}


### Optional - Send AI Message - Nigerian Pidgin
POST {{baseUrl}}/ai/conversations/{{conversationPublicId}}/messages
Authorization: Bearer {{authAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "message": "Explain this medicine for me based on my record.",
  "language": "Pidgin"
}


### Optional Cleanup - Archive AI Conversation
PATCH {{baseUrl}}/ai/conversations/{{conversationPublicId}}/archive
Authorization: Bearer {{authAccessToken}}
Accept: application/json
