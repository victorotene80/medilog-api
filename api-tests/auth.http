@baseUrl = http://localhost:8080/api/v1
@email = test@example.com
@phone = +2347015332038
@password = NewPassword123!

### Register
# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json
Accept: application/json

{
  "first_name": "Test",
  "last_name": "User",
  "email": "{{email}}",
  "phone": "{{phone}}",
  "password": "{{password}}",
  "dob": "1995-06-15",
  "sex": 1,
  "blood_type": "A+",
  "country_code": "NG"
}

### Login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "phone": "{{phone}}",
  "password": "{{password}}"
}

> {%
    let body = response.body || {};
    if (typeof body === "string") {
        body = JSON.parse(body);
    }

    const tokens = body.data && body.data.tokens ? body.data.tokens : null;
    if (!tokens || !tokens.access_token || !tokens.refresh_token) {
        throw new Error("Expected login response tokens at data.tokens.access_token and data.tokens.refresh_token");
    }

    client.global.set("accessToken", tokens.access_token);
    client.global.set("authAccessToken", tokens.access_token);
    client.global.set("refreshToken", tokens.refresh_token);
    client.global.set("authRefreshToken", tokens.refresh_token);
%}

### Google Login
# @name googleLogin
POST {{baseUrl}}/auth/google
Content-Type: application/json
Accept: application/json

{
  "idToken": "{{googleIdToken}}"
}

> {%
    let body = response.body || {};
    if (typeof body === "string") {
        body = JSON.parse(body);
    }

    const tokens = body.data && body.data.tokens ? body.data.tokens : null;
    if (tokens && tokens.access_token) {
        client.global.set("accessToken", tokens.access_token);
        client.global.set("authAccessToken", tokens.access_token);
    }
    if (tokens && tokens.refresh_token) {
        client.global.set("refreshToken", tokens.refresh_token);
        client.global.set("authRefreshToken", tokens.refresh_token);
    }
%}

### Forgot Password
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json
Accept: application/json

{
  "recipient": "{{email}}"
}

### Reset Password
POST {{baseUrl}}/auth/reset-password
Content-Type: application/json
Accept: application/json

{
  "recipient": "{{email}}",
  "otp_code": "{{otpCode}}",
  "new_password": "{{password}}"
}

### Request OTP
POST {{baseUrl}}/auth/otp/request
Content-Type: application/json
Accept: application/json

{
  "recipient": "{{phone}}",
  "channel": "sms",
  "purpose": "phone_verification"
}

### Verify OTP
POST {{baseUrl}}/auth/otp/verify
Content-Type: application/json
Accept: application/json

{
  "recipient": "{{phone}}",
  "code": "{{otpCode}}",
  "channel": "sms",
  "purpose": "phone_verification"
}

### Verify Onboarding OTP
# @name verifyOnboarding
POST {{baseUrl}}/auth/otp/verify-onboarding
Content-Type: application/json
Accept: application/json

{
  "recipient": "{{phone}}",
  "code": "{{otpCode}}",
  "channel": "sms",
  "purpose": "phone_verification"
}

> {%
    let body = response.body || {};
    if (typeof body === "string") {
        body = JSON.parse(body);
    }

    const tokens = body.data && body.data.tokens ? body.data.tokens : null;
    if (!tokens || !tokens.access_token || !tokens.refresh_token) {
        throw new Error("Expected onboarding response tokens at data.tokens.access_token and data.tokens.refresh_token");
    }

    client.global.set("accessToken", tokens.access_token);
    client.global.set("authAccessToken", tokens.access_token);
    client.global.set("refreshToken", tokens.refresh_token);
    client.global.set("authRefreshToken", tokens.refresh_token);
    client.global.set("onboardingAccessToken", tokens.access_token);
%}

### Logout
# @name logout
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{authAccessToken}}
Content-Type: application/json
Accept: application/json

### Change Password
POST {{baseUrl}}/auth/change-password
Authorization: Bearer {{authAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "old_password": "{{password}}",
  "new_password": "NewPassword456!"
}

### --- Parsed Tokens ---
# Run Login, Google Login, or Verify Onboarding first.
# Tokens are stored globally by the response handlers above and reused as:
# Authorization: Bearer {{authAccessToken}}
#
# Previous lazy request variables kept for reference:
# @accessToken = {{login.response.body.data.tokens.access_token}}
# @refreshToken = {{login.response.body.data.tokens.refresh_token}}
# @onboardingAccessToken = {{verifyOnboarding.response.body.data.tokens.access_token}}
