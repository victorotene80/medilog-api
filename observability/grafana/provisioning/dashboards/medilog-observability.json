{
  "uid": "medilog-observability",
  "title": "Medilog Observability",
  "tags": ["medilog", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Prometheus Targets UP",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up == 1)",
          "legendFormat": "Targets UP"
        }
      ],
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "API Response Time (p95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, rate(medilog_http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "{{method}} {{route}}"
        }
      ],
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "API Request Rate (by Status)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(medilog_http_request_duration_seconds_count[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ],
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 }
    },
    {
      "id": 4,
      "title": "API Request Count (by Route)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(medilog_http_request_duration_seconds_count[5m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ],
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 }
    },
    {
      "id": 5,
      "title": "Database Query Duration (p95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, rate(medilog_gorm_query_duration_seconds_bucket[5m]))",
          "legendFormat": "{{operation}} {{table}}"
        }
      ],
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 12 }
    },
    {
      "id": 6,
      "title": "Database Operations by Table",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(medilog_gorm_query_duration_seconds_count[5m])) by (table, operation)",
          "legendFormat": "{{table}} ({{operation}})"
        }
      ],
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 12 }
    },
    {
      "id": 7,
      "title": "Go Goroutines",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "go_goroutines",
          "legendFormat": "Goroutines"
        }
      ],
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 18 }
    },
    {
      "id": 8,
      "title": "Memory Usage (MB)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "go_memstats_alloc_bytes / 1024 / 1024",
          "legendFormat": "Heap Alloc"
        }
      ],
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 18 }
    },
    {
      "id": 9,
      "title": "Prometheus Scrape Duration (ms)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "scrape_duration_seconds * 1000",
          "legendFormat": "{{job}}"
        }
      ],
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 24 }
    },
    {
      "id": 10,
      "title": "API Requests by Method",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(medilog_http_request_duration_seconds_count[5m])) by (method)",
          "legendFormat": "{{method}}"
        }
      ],
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 24 }
    }
  ]
}