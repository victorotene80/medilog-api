# MediLog API — production environment for the self-hosted Oracle Cloud VM.
# Copy to .env on the VM (never commit the real file):
#   cp .env.prod.example .env && chmod 600 .env
# Then fill in every blank below.

# ---------------------------------------------------------------------------
# Domain / TLS (read by Caddy — see Caddyfile)
# ---------------------------------------------------------------------------
MEDILOG_DOMAIN=                  # e.g. medilog-api.duckdns.org

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
SESSION_PEPPER=                  # openssl rand -hex 32
JWT_SECRET=                      # openssl rand -hex 64
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# ---------------------------------------------------------------------------
# Database — docker-compose.prod.yml overrides DB_HOST/DB_PORT to the
# `postgres` service; these values also seed the postgres container itself.
# ---------------------------------------------------------------------------
DB_USER=medilog
DB_PASSWORD=                     # openssl rand -hex 24
DB_NAME=medilog
DB_SSLMODE=disable                # same-host TCP over the compose network, not a public link
DB_MAX_OPEN=20
DB_MAX_IDLE=10
DB_MAX_LIFETIME=300
DB_AUTO_MIGRATE=false             # migrations run via `docker compose run --rm migrate`
DB_VERIFY_SCHEMA=true

# ---------------------------------------------------------------------------
# Redis — docker-compose.prod.yml overrides REDIS_HOST/REDIS_PORT to the
# `redis` service; REDIS_PASSWORD also seeds the redis container itself.
# ---------------------------------------------------------------------------
REDIS_PASSWORD=                  # openssl rand -hex 24
REDIS_DB=0
REDIS_TTL=15m

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
HTTP_TIMEOUT=10s
CORS_ORIGINS=*                   # tighten once the mobile app's release channel is known
APP_ENV=production

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# AI (Claude)
# ---------------------------------------------------------------------------
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=1024
CLAUDE_TIMEOUT=30s
CLAUDE_API_VERSION=2023-06-01
AI_ENABLED=true
AI_PROVIDER=claude
AI_CONTEXT_WINDOW_TOKENS=3500
AI_MAX_CONTEXT_MESSAGES=20
AI_SUMMARY_TOKEN_THRESHOLD=6000

# ---------------------------------------------------------------------------
# SMS providers — config.go requires these to be non-empty at boot even if
# SMS_ENABLED=false, because the constructors read them unconditionally. If
# you don't have real SMS credentials yet, put in a placeholder string (not
# used unless SMS_ENABLED=true), OTP delivery will just fail.
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_BASE_URL=https://api.twilio.com
TWILIO_WHATSAPP_FROM_NUMBER=
TWILIO_MESSAGES_URL=https://api.twilio.com/2010-04-01/Accounts/{accountSid}/Messages.json
BULK_SMS_PROD_BASEURL=https://www.bulksmsnigeria.com/api/v2
BULK_SMS_TEST_BASEURL=https://www.bulksmsnigeria.com/api/sandbox/v2
BULK_SMS_SEND_MESSAGE=/sms
BULK_SMS_CHECK_BALANCE=
BULK_SMS_SENDER=Medilog
BULK_SMS_GET_DELIVERY_REPORT=
BULK_SMS_API_TOKEN=
BULK_SMS_API_LEGACY_TOKEN=
SMS_ENABLED=true
SMS_MAX_BULK_FAILURES=3
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_MESSAGES_URL=https://api.telnyx.com/v2/messages

# ---------------------------------------------------------------------------
# Reminder scheduler — driven by the `scheduler-cron` compose service instead
# of Cloud Scheduler. Start it with:
#   docker compose -f docker-compose.prod.yml --profile scheduler up -d
# ---------------------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TICK_TOKEN=            # openssl rand -hex 32
SCHEDULER_POLL_INTERVAL=1m
SCHEDULER_CATCHUP_WINDOW=6h
SCHEDULER_LEAD_TIME=5m
SCHEDULER_BATCH_SIZE=500

# ---------------------------------------------------------------------------
# Container resource limits — sized for a single Oracle Always Free Ampere A1
# VM. As of mid-2026 the free-tier cap is 2 OCPU / 12GB total (Oracle halved
# it from the original 4/24 in June 2026 with no announcement — instances
# above the new cap get shut down). These defaults leave headroom on purpose:
# the OS, Docker, and Caddy need some too.
# ---------------------------------------------------------------------------
POSTGRES_MEMORY_LIMIT=1024MB
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
POSTGRES_MAX_CONNECTIONS=50
REDIS_MEMORY_LIMIT=512mb
REDIS_MAXMEMORY=384mb
API_MEMORY_LIMIT=512m
API_GOMEMLIMIT=384MiB
API_GOGC=75
