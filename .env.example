# MediLog API — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Security
SESSION_PEPPER=           # 64-char hex: openssl rand -hex 32
JWT_SECRET=               # 128-char hex: openssl rand -hex 64
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=auth_user
DB_PASSWORD=
DB_NAME=medilog
DB_SSLMODE=disable
DB_MAX_OPEN=20
DB_MAX_IDLE=10
DB_MAX_LIFETIME=300
DB_AUTO_MIGRATE=false
DB_VERIFY_SCHEMA=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=15m

# HTTP
HTTP_TIMEOUT=10s

# Google OAuth
GOOGLE_CLIENT_ID=

# AI (Claude)
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=1024
CLAUDE_API_VERSION=2023-06-01
AI_ENABLED=true
AI_PROVIDER=claude
AI_CONTEXT_WINDOW_TOKENS=3500
AI_MAX_CONTEXT_MESSAGES=20
AI_SUMMARY_TOKEN_THRESHOLD=6000

# SMS Providers
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_BASE_URL=https://api.twilio.com
TWILIO_WHATSAPP_FROM_NUMBER=
TWILIO_MESSAGES_URL=https://api.twilio.com/2010-04-01/Accounts/{accountSid}/Messages.json
BULK_SMS_PROD_BASEURL=https://www.bulksmsnigeria.com/api/v2
BULK_SMS_TEST_BASEURL=https://www.bulksmsnigeria.com/api/sandbox/v2
BULK_SMS_SEND_MESSAGE=/sms
BULK_SMS_CHECK_BALANCE=
BULK_SMS_SENDER=Medilog
BULK_SMS_GET_DELIVERY_REPORT=
BULK_SMS_API_TOKEN=
BULK_SMS_API_LEGACY_TOKEN=
SMS_ENABLED=true
SMS_MAX_BULK_FAILURES=3
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_MESSAGES_URL=https://api.telnyx.com/v2/messages

# ---------------------------------------------------------------
# Reminder scheduler
# ---------------------------------------------------------------
# Generates medication and appointment reminders into the in-app inbox.
# Disabled by default: enabling it starts writing notifications.
SCHEDULER_ENABLED=false
# Shared secret for POST /internal/scheduler/reminders/tick, the endpoint that
# drives the scan. Required whenever SCHEDULER_ENABLED=true — startup fails
# without it, because the route is the only way reminders get generated now.
# The in-process ticker it replaced could not survive Cloud Run throttling the
# container's CPU between requests. Generate with: openssl rand -hex 32
SCHEDULER_TICK_TOKEN=
# Kept for the commented-out in-process ticker in
# internal/infrastructure/scheduler/reminder.go; the live cadence is the Cloud
# Scheduler cron in cloudbuild.yaml (_SCHEDULER_CRON), which matches it.
SCHEDULER_POLL_INTERVAL=1m
# How far back each tick looks. This is the entire catch-up mechanism — there is
# no watermark table. Clamped to 24h so a long outage cannot flood an inbox.
SCHEDULER_CATCHUP_WINDOW=6h
SCHEDULER_LEAD_TIME=5m
SCHEDULER_BATCH_SIZE=500
